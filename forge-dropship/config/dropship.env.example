# FORGE DROPSHIP — runtime config TEMPLATE
#
# cp dropship.env.example dropship.env, fill in values, then ship it:
#   ./deploy/push.sh root@24.199.81.124   (Mac only — git push does NOT carry .env files)
#
# Every key's cost, what it unlocks, setup steps, and traps: ../PLUG_AND_PLAY.md
# dropship.env is git-ignored, lives outside the web root, must 404 over HTTP.

# --- Shopify (store backbone) ------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_...
SHOPIFY_API_VERSION=2024-10

# --- WinningHunter (product + ad research) -----------------------------------
WINNINGHUNTER_API_KEY=
# Overrides — leave commented unless the shape changes (PLUG_AND_PLAY.md §8a):
# WINNINGHUNTER_API_BASE=https://app.winninghunter.com
# WINNINGHUNTER_AUTH_HEADER=Authorization
# WINNINGHUNTER_AUTH_PREFIX=
# WINNINGHUNTER_HEALTH_PATH=/api/v1/me
# WINNINGHUNTER_ADS_PATH=/api/v1/ads
# WINNINGHUNTER_STORE_PATH=/api/v1/stores
# WINNINGHUNTER_PRODUCTS_PATH=/api/v1/products

# --- EverBee (Etsy keyword + listing research) -------------------------------
EVERBEE_CLIENT_ID=
EVERBEE_CLIENT_SECRET=
# EVERBEE_API_BASE=https://research-open-api.everbee.com

# --- Higgsfield (ad creative generation) --------------------------------------
# Usually leave blank — falls back to the key already in daycare.env/agency.env.
# Set here only to bill this workspace separately (PLUG_AND_PLAY.md §8b).
# HIGGSFIELD_API_KEY=
# HIGGSFIELD_API_SECRET=

# --- AutoDS (sourcing + order automation) ------------------------------------
# Read PLUG_AND_PLAY.md §8c before buying — REST API has an unpublished
# activation fee with no trial; the free MCP server (below) may be the better path.
AUTODS_API_KEY=
AUTODS_STORE_ID=
# AUTODS_MARKETPLACE_PATH=/marketplace/products/

# --- GetHooked (product / ad-spy research) -----------------------------------
# In active use — no client file wired yet (PLUG_AND_PLAY.md §8g), so nothing
# reads this key today. Key here now so it's ready the moment it's wired.
GETHOOKED_API_KEY=

# --- Apify -> Meta Ad Library (competitor-ad watcher) ------------------------
# Bills per ad scraped — PLUG_AND_PLAY.md §8d. Manual pulls only, nothing polls.
APIFY_TOKEN=
DROPSHIP_ADSPY_ACTOR=curious_coder~facebook-ads-library-scraper
DROPSHIP_ADSPY_MAX_ADS=50
DROPSHIP_ADSPY_COUNTRY=US

# --- Meta Ads (Facebook / Instagram) -----------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_MAP={}

# --- Anthropic (the crew's own Claude key, optional) -------------------------
# Unset = falls back to the shared agency/wholesale key.
# DROPSHIP_ANTHROPIC_API_KEY=sk-ant-...

# --- Cadence + self-improvement (box loop knobs) ------------------------------
FORGE_DROPSHIP_BRIEF_EVERY_H=24
FORGE_DROPSHIP_LEARN_EVERY=8
FORGE_DROPSHIP_LEARN_GAP_MIN=45

# --- Obsidian brain (vault) ----------------------------------------------------
# FORGE_VAULT=/Users/yg4st/Desktop/Agentic-OS/vault

