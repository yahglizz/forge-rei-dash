# Slack workspace for FORGE REI OS (replaces Telegram). Copy to slack.env (same dir). slack.env is gitignored (*.env).
# 1) api.slack.com/apps -> your app -> OAuth & Permissions -> Bot User OAuth Token (starts xoxb-). Paste below.
#    Bot scopes needed: chat:write, chat:write.public, channels:read, groups:read, im:write, reactions:write, users:read
SLACK_BOT_TOKEN=
# 2) Socket Mode (box/Mac dials out, no public URL): Basic Information -> App-Level Tokens -> scope connections:write (starts xapp-).
SLACK_APP_TOKEN=
# 3) Only if you use HTTP events instead of Socket Mode: Basic Information -> Signing Secret.
SLACK_SIGNING_SECRET=
# 4) Test channel id (right-click channel -> View details -> bottom, starts C) or your DM id (starts D). Used by the smoke test only.
SLACK_TEST_CHANNEL_ID=
# 5) Comma-separated Slack member ids (U...) allowed to tap Approve/Dismiss. Blank = nobody.
SLACK_ALLOWED_USER_IDS=
